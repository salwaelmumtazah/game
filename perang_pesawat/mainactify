// ============================================================================
// CORE GAME ENGINE
// ============================================================================

private class SkyStrikeEngine(
    private val storage: GameStorage,
    val sprites: SpriteBank,
    private val audio: GameAudioManager
) {
    var phase by mutableStateOf(GamePhase.MENU)
    var score by mutableIntStateOf(0)
    var runCoins by mutableIntStateOf(0)
    var totalCoins by mutableIntStateOf(storage.totalCoins)
    var highScore by mutableIntStateOf(storage.highScore)
    var firepowerLevel by mutableIntStateOf(storage.firepowerLevel)
    var fireRateLevel by mutableIntStateOf(storage.fireRateLevel)
    var armorLevel by mutableIntStateOf(storage.armorLevel)
    var sfxEnabled by mutableStateOf(storage.sfxEnabled)
    var bgmEnabled by mutableStateOf(storage.bgmEnabled)

    var wave by mutableIntStateOf(1)
    var playerHp by mutableIntStateOf(5)
    var playerMaxHp by mutableIntStateOf(5)
    var weaponLevel by mutableIntStateOf(1)
    var shieldActive by mutableStateOf(false)
    var bossHpFraction by mutableFloatStateOf(0f)
    var bannerText by mutableStateOf("")
    var hapticTrigger by mutableIntStateOf(0)

    var frameTick by mutableLongStateOf(0L)

    var screenW = 0f
        private set
    var screenH = 0f
        private set
    var unit = 1f
        private set
    private var viewportReady = false

    var playerX = 0f
        private set
    var playerY = 0f
        private set
    var playerBank = 0f
        private set
    var invulnTimer = 0f
        private set
    var shieldTimer = 0f
        private set
    var muzzleFlashTimer = 0f
        private set
    private var shootCooldown = 0f

    var shakeOffsetX = 0f
        private set
    var shakeOffsetY = 0f
        private set
    private var shakeTimer = 0f
    private var shakeIntensity = 0f

    private var waveEnemiesToSpawn = 0
    private var spawnTimer = 0f
    private var bossWarningTimer = 0f
    private var bossSpawnedThisWave = false
    private var bannerTimer = 0f
    private var oceanScrollPx = 0f
    private var elapsedTime = 0f

    val playerBullets = Array(140) { Bullet() }
    val enemyBullets = Array(140) { Bullet() }
    val enemies = Array(36) { Enemy() }
    val powerUps = Array(28) { PowerUp() }
    val particles = Array(180) { Particle() }
    val shockwaves = Array(18) { Shockwave() }

    val islands = mutableListOf<Island>()
    val clouds = mutableListOf<Cloud>()

    val reusablePath = Path()

    fun toggleSfx() {
        sfxEnabled = !sfxEnabled
        storage.sfxEnabled = sfxEnabled
        audio.updateSfxEnabled(sfxEnabled)
    }

    fun toggleBgm() {
        bgmEnabled = !bgmEnabled
        storage.bgmEnabled = bgmEnabled
        audio.updateBgmEnabled(bgmEnabled)
    }

    fun upgradeCost(currentLevel: Int): Int = currentLevel * 100

    fun buyFirepower(): Boolean {
        if (firepowerLevel >= 10) return false
        val cost = upgradeCost(firepowerLevel)
        if (totalCoins < cost) return false
        totalCoins -= cost
        firepowerLevel++
        storage.totalCoins = totalCoins
        storage.firepowerLevel = firepowerLevel
        audio.playPowerUp()
        return true
    }

    fun buyFireRate(): Boolean {
        if (fireRateLevel >= 10) return false
        val cost = upgradeCost(fireRateLevel)
        if (totalCoins < cost) return false
        totalCoins -= cost
        fireRateLevel++
        storage.totalCoins = totalCoins
        storage.fireRateLevel = fireRateLevel
        audio.playPowerUp()
        return true
    }

    fun buyArmor(): Boolean {
        if (armorLevel >= 10) return false
        val cost = upgradeCost(armorLevel)
        if (totalCoins < cost) return false
        totalCoins -= cost
        armorLevel++
        storage.totalCoins = totalCoins
        storage.armorLevel = armorLevel
        audio.playPowerUp()
        return true
    }

    fun setViewport(width: Float, height: Float) {
        if (width <= 0f || height <= 0f) return
        screenW = width
        screenH = height
        unit = width / 1080f

        if (!viewportReady) {
            viewportReady = true
            playerX = screenW * 0.5f
            playerY = screenH * 0.78f
            initScenery()
        } else {
            playerX = playerX.coerceIn(50f * unit, screenW - 50f * unit)
            playerY = playerY.coerceIn(screenH * 0.14f, screenH - 70f * unit)
        }
    }

    private fun initScenery() {
        islands.clear()
        clouds.clear()
        repeat(4) { i ->
            islands.add(
                Island(
                    x = Random.nextFloat() * screenW,
                    y = (i / 4f) * screenH,
                    radiusX = (110f + Random.nextFloat() * 140f) * unit,
                    radiusY = (70f + Random.nextFloat() * 100f) * unit,
                    rotation = Random.nextFloat() * 360f
                )
            )
        }
        repeat(7) { i ->
            clouds.add(
                Cloud(
                    x = Random.nextFloat() * screenW,
                    y = (i / 7f) * screenH,
                    radius = (85f + Random.nextFloat() * 120f) * unit,
                    speedFactor = 1.4f + Random.nextFloat() * 0.9f,
                    alpha = 0.06f + Random.nextFloat() * 0.06f
                )
            )
        }
    }

    fun startNewGame() {
        clearPools()
        score = 0
        runCoins = 0
        wave = 1
        weaponLevel = 1
        playerMaxHp = 4 + armorLevel
        playerHp = playerMaxHp
        invulnTimer = 1.2f
        shieldTimer = 0f
        shieldActive = false
        muzzleFlashTimer = 0f
        shakeTimer = 0f
        shakeOffsetX = 0f
        shakeOffsetY = 0f
        shootCooldown = 0f
        bossHpFraction = 0f

        if (viewportReady) {
            playerX = screenW * 0.5f
            playerY = screenH * 0.80f
        }
        playerBank = 0f

        setupWave(1)
        phase = GamePhase.PLAYING
    }

    fun pauseGame() {
        if (phase == GamePhase.PLAYING) phase = GamePhase.PAUSED
    }

    fun resumeGame() {
        if (phase == GamePhase.PAUSED) phase = GamePhase.PLAYING
    }

    fun returnToMenu() {
        clearPools()
        bossHpFraction = 0f
        bannerText = ""
        shakeTimer = 0f
        shakeOffsetX = 0f
        shakeOffsetY = 0f
        if (viewportReady) {
            playerX = screenW * 0.5f
            playerY = screenH * 0.78f
        }
        phase = GamePhase.MENU
    }

    private fun clearPools() {
        for (b in playerBullets) b.active = false
        for (b in enemyBullets) b.active = false
        for (e in enemies) e.active = false
        for (p in powerUps) p.active = false
        for (pt in particles) pt.active = false
        for (sw in shockwaves) sw.active = false
    }

    private fun setupWave(waveNum: Int) {
        wave = waveNum
        bossSpawnedThisWave = false
        bossWarningTimer = 0f
        bossHpFraction = 0f
        waveEnemiesToSpawn = if (waveNum % 3 == 0) 6 + waveNum else 10 + waveNum * 3
        spawnTimer = 0.7f
        showBanner("WAVE $waveNum", 2.0f)
    }

    private fun showBanner(text: String, duration: Float) {
        bannerText = text
        bannerTimer = duration
    }

    private fun triggerShake(duration: Float, intensityPx: Float) {
        if (intensityPx >= shakeIntensity || shakeTimer <= 0f) {
            shakeTimer = duration
            shakeIntensity = intensityPx
        }
    }

    fun movePlayer(dx: Float, dy: Float) {
        if (phase != GamePhase.PLAYING || !viewportReady) return
        val marginX = 56f * unit
        val minY = screenH * 0.14f
        val maxY = screenH - 72f * unit

        playerX = (playerX + dx).coerceIn(marginX, screenW - marginX)
        playerY = (playerY + dy).coerceIn(minY, maxY)

        val targetBank = (dx / (24f * unit)).coerceIn(-1f, 1f)
        playerBank = playerBank * 0.65f + targetBank * 0.35f
    }

    fun update(dt: Float) {
        if (!viewportReady) return
        elapsedTime += dt

        if (phase == GamePhase.MENU || phase == GamePhase.PLAYING) {
            updateScenery(dt)
        }

        if (phase == GamePhase.MENU) {
            playerX = screenW * 0.5f + sin(elapsedTime * 1.4f) * (60f * unit)
            playerY = screenH * 0.76f + cos(elapsedTime * 2.1f) * (14f * unit)
            playerBank = cos(elapsedTime * 1.4f) * 0.35f
            frameTick++
            return
        }

        if (phase != GamePhase.PLAYING) return

        playerBank *= (1f - (8f * dt).coerceAtMost(1f))

        if (invulnTimer > 0f) invulnTimer = (invulnTimer - dt).coerceAtLeast(0f)
        if (muzzleFlashTimer > 0f) muzzleFlashTimer = (muzzleFlashTimer - dt).coerceAtLeast(0f)
        if (shieldTimer > 0f) {
            shieldTimer = (shieldTimer - dt).coerceAtLeast(0f)
            if (shieldTimer <= 0f) shieldActive = false
        }
        if (bannerTimer > 0f) {
            bannerTimer -= dt
            if (bannerTimer <= 0f) bannerText = ""
        }

        if (shakeTimer > 0f) {
            shakeTimer = (shakeTimer - dt).coerceAtLeast(0f)
            val decay = (shakeTimer * 4f).coerceIn(0f, 1f)
            shakeOffsetX = (Random.nextFloat() * 2f - 1f) * shakeIntensity * decay
            shakeOffsetY = (Random.nextFloat() * 2f - 1f) * shakeIntensity * decay
        } else {
            shakeOffsetX = 0f
            shakeOffsetY = 0f
            shakeIntensity = 0f
        }

        shootCooldown -= dt
        if (shootCooldown <= 0f) {
            firePlayerWeapon()
            val baseInterval = (0.19f - (fireRateLevel - 1) * 0.011f).coerceAtLeast(0.085f)
            shootCooldown = baseInterval
        }

        updateWaveSpawning(dt)
        updatePlayerBullets(dt)
        updateEnemies(dt)
        updateEnemyBullets(dt)
        updatePowerUps(dt)
        updateParticles(dt)
        updateShockwaves(dt)

        frameTick++
    }

    private fun updateScenery(dt: Float) {
        val baseSpeed = 190f * unit
        oceanScrollPx += baseSpeed * dt
        if (oceanScrollPx > 100000f) oceanScrollPx = 0f

        for (island in islands) {
            island.y += baseSpeed * 0.65f * dt
            if (island.y - island.radiusY > screenH + 100f * unit) {
                island.y = -island.radiusY - 80f * unit
                island.x = Random.nextFloat() * screenW
            }
        }
        for (cloud in clouds) {
            cloud.y += baseSpeed * cloud.speedFactor * dt
            if (cloud.y - cloud.radius > screenH + 80f * unit) {
                cloud.y = -cloud.radius - 60f * unit
                cloud.x = Random.nextFloat() * screenW
            }
        }
    }

    private fun firePlayerWeapon() {
        val dmg = 10f + (firepowerLevel - 1) * 4.5f
        val speed = -1450f * unit
        val noseY = playerY - 48f * unit
        val spreadVx = 240f * unit

        muzzleFlashTimer = 0.045f
        audio.playShoot()

        when (weaponLevel) {
            1 -> {
                spawnPlayerBullet(playerX, noseY, 0f, speed, dmg, Color(0xFF00E5FF), BulletStyle.NORMAL)
            }
            2 -> {
                spawnPlayerBullet(playerX - 22f * unit, noseY + 8f * unit, 0f, speed, dmg, Color(0xFF00E5FF), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX + 22f * unit, noseY + 8f * unit, 0f, speed, dmg, Color(0xFF00E5FF), BulletStyle.NORMAL)
            }
            3 -> {
                spawnPlayerBullet(playerX, noseY, 0f, speed, dmg * 1.05f, Color(0xFF40C4FF), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX - 30f * unit, noseY + 12f * unit, -spreadVx * 0.65f, speed * 0.94f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
                spawnPlayerBullet(playerX + 30f * unit, noseY + 12f * unit, spreadVx * 0.65f, speed * 0.94f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
            }
            4 -> {
                spawnPlayerBullet(playerX - 18f * unit, noseY, 0f, speed, dmg, Color(0xFF69F0AE), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX + 18f * unit, noseY, 0f, speed, dmg, Color(0xFF69F0AE), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX - 42f * unit, noseY + 16f * unit, -spreadVx * 0.95f, speed * 0.92f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
                spawnPlayerBullet(playerX + 42f * unit, noseY + 16f * unit, spreadVx * 0.95f, speed * 0.92f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
            }
            else -> {
                spawnPlayerBullet(playerX, noseY - 8f * unit, 0f, speed * 1.08f, dmg * 1.25f, Color(0xFFFFD740), BulletStyle.LASER)
                spawnPlayerBullet(playerX - 24f * unit, noseY + 6f * unit, -spreadVx * 0.42f, speed, dmg, Color(0xFF00E5FF), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX + 24f * unit, noseY + 6f * unit, spreadVx * 0.42f, speed, dmg, Color(0xFF00E5FF), BulletStyle.NORMAL)
                spawnPlayerBullet(playerX - 48f * unit, noseY + 18f * unit, -spreadVx * 1.1f, speed * 0.9f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
                spawnPlayerBullet(playerX + 48f * unit, noseY + 18f * unit, spreadVx * 1.1f, speed * 0.9f, dmg * 0.95f, Color(0xFFFFAB40), BulletStyle.MISSILE)
            }
        }
    }

    private fun spawnPlayerBullet(
        x: Float,
        y: Float,
        vx: Float,
        vy: Float,
        damage: Float,
        color: Color,
        style: BulletStyle = BulletStyle.NORMAL
    ) {
        for (b in playerBullets) {
            if (!b.active) {
                b.active = true
                b.style = style
                b.x = x
                b.y = y
                b.vx = vx
                b.vy = vy
                b.radius = when (style) {
                    BulletStyle.LASER -> 14f * unit
                    BulletStyle.MISSILE -> 12f * unit
                    BulletStyle.NORMAL, BulletStyle.BOMB -> 9f * unit
                }
                b.damage = damage
                b.color = color
                return
            }
        }
    }

    private fun spawnEnemyBullet(
        x: Float,
        y: Float,
        vx: Float,
        vy: Float,
        radius: Float = 11f * unit,
        color: Color = Color(0xFFFF5252),
        style: BulletStyle = BulletStyle.NORMAL
    ) {
        for (b in enemyBullets) {
            if (!b.active) {
                b.active = true
                b.style = style
                b.x = x
                b.y = y
                b.vx = vx
                b.vy = vy
                b.radius = radius
                b.damage = 1f
                b.color = color
                return
            }
        }
    }

    private fun updateWaveSpawning(dt: Float) {
        val activeEnemies = countActiveEnemies()

        if (waveEnemiesToSpawn > 0) {
            spawnTimer -= dt
            if (spawnTimer <= 0f) {
                spawnWaveEnemy()
                waveEnemiesToSpawn--
                val baseDelay = (1.15f - wave * 0.055f).coerceAtLeast(0.42f)
                spawnTimer = baseDelay + Random.nextFloat() * 0.35f
            }
            return
        }

        if (wave % 3 == 0 && !bossSpawnedThisWave) {
            if (activeEnemies == 0) {
                if (bossWarningTimer <= 0f) {
                    bossWarningTimer = 2.4f
                    showBanner("WARNING: SKY FORTRESS", 2.4f)
                    audio.playBossWarning()
                } else {
                    bossWarningTimer -= dt
                    if (bossWarningTimer <= 0f) {
                        spawnBoss()
                        bossSpawnedThisWave = true
                    }
                }
            }
        } else if (activeEnemies == 0) {
            setupWave(wave + 1)
        }
    }

    private fun countActiveEnemies(): Int {
        var count = 0
        for (e in enemies) if (e.active) count++
        return count
    }

    private fun spawnWaveEnemy() {
        val e = findInactiveEnemy() ?: return
        val pad = 80f * unit
        val roll = Random.nextFloat()

        e.active = true
        e.x = pad + Random.nextFloat() * (screenW - pad * 2f)
        e.y = -90f * unit
        e.age = 0f
        e.hitFlash = 0f
        e.bossPattern = 0

        when {
            wave >= 2 && roll < 0.16f -> {
                e.type = EnemyType.BOMBER
                e.radius = 68f * unit
                e.maxHp = 85f + wave * 16f
                e.hp = e.maxHp
                e.vx = 0f
                e.vy = (135f + wave * 6f) * unit
                e.shootTimer = 1.4f
            }
            roll < 0.52f -> {
                e.type = EnemyType.STRIKER
                e.radius = 48f * unit
                e.maxHp = 32f + wave * 7f
                e.hp = e.maxHp
                e.vx = 0f
                e.vy = (220f + wave * 12f) * unit
                e.shootTimer = 1.1f + Random.nextFloat() * 0.6f
            }
            else -> {
                e.type = EnemyType.SCOUT
                e.radius = 40f * unit
                e.maxHp = 14f + wave * 3.5f
                e.hp = e.maxHp
                e.vx = (Random.nextFloat() - 0.5f) * 180f * unit
                e.vy = (320f + wave * 18f) * unit
                e.shootTimer = 1.6f
            }
        }
    }

    private fun spawnBoss() {
        val boss = findInactiveEnemy() ?: return
        val bossTier = (wave / 3).coerceAtLeast(1)
        boss.active = true
        boss.type = EnemyType.BOSS
        boss.x = screenW * 0.5f
        boss.y = -180f * unit
        boss.vx = (150f + bossTier * 20f) * unit
        boss.vy = 180f * unit
        boss.radius = 132f * unit
        boss.maxHp = 520f + bossTier * 420f
        boss.hp = boss.maxHp
        boss.shootTimer = 1.3f
        boss.age = 0f
        boss.hitFlash = 0f
        boss.bossPattern = 0
        bossHpFraction = 1f
    }

    private fun findInactiveEnemy(): Enemy? {
        for (e in enemies) if (!e.active) return e
        return null
    }

    private fun updatePlayerBullets(dt: Float) {
        for (b in playerBullets) {
            if (!b.active) continue
            b.x += b.vx * dt
            b.y += b.vy * dt

            if (b.y < -60f * unit || b.x < -60f * unit || b.x > screenW + 60f * unit) {
                b.active = false
                continue
            }

            for (e in enemies) {
                if (!e.active) continue
                val dx = b.x - e.x
                val dy = b.y - e.y
                val hitR = b.radius + e.radius
                if (dx * dx + dy * dy <= hitR * hitR) {
                    b.active = false
                    e.hp -= b.damage
                    e.hitFlash = 0.08f
                    spawnBurst(b.x, b.y, 4, Color(0xFF80D8FF), 180f * unit)

                    if (e.type == EnemyType.BOSS) {
                        bossHpFraction = (e.hp / e.maxHp).coerceIn(0f, 1f)
                    }
                    if (e.hp <= 0f) {
                        onEnemyDestroyed(e)
                    }
                    break
                }
            }
        }
    }

    private fun updateEnemies(dt: Float) {
        val playerHitR = 22f * unit

        for (e in enemies) {
            if (!e.active) continue
            e.age += dt
            if (e.hitFlash > 0f) e.hitFlash = (e.hitFlash - dt).coerceAtLeast(0f)

            when (e.type) {
                EnemyType.SCOUT -> {
                    e.x += (e.vx + sin(e.age * 4f) * 140f * unit) * dt
                    e.y += e.vy * dt
                    e.x = e.x.coerceIn(e.radius, screenW - e.radius)

                    if (wave >= 3) {
                        e.shootTimer -= dt
                        if (e.shootTimer <= 0f && e.y > 40f * unit && e.y < screenH * 0.6f) {
                            spawnEnemyBullet(e.x, e.y + e.radius * 0.6f, 0f, 520f * unit)
                            e.shootTimer = 2.4f
                        }
                    }
                }
                EnemyType.STRIKER -> {
                    e.y += e.vy * dt
                    e.shootTimer -= dt
                    if (e.shootTimer <= 0f && e.y > 40f * unit && e.y < screenH * 0.65f) {
                        val dx = playerX - e.x
                        val dy = playerY - e.y
                        val dist = hypot(dx, dy).coerceAtLeast(1f)
                        val speed = (470f + wave * 14f) * unit
                        spawnEnemyBullet(e.x, e.y + e.radius * 0.6f, dx / dist * speed, dy / dist * speed)
                        e.shootTimer = (1.9f - wave * 0.05f).coerceAtLeast(1.0f)
                    }
                }
                EnemyType.BOMBER -> {
                    e.y += e.vy * dt
                    e.shootTimer -= dt
                    if (e.shootTimer <= 0f && e.y > 60f * unit && e.y < screenH * 0.6f) {
                        val speed = 400f * unit
                        spawnEnemyBullet(e.x, e.y + e.radius * 0.6f, 0f, speed, 18f * unit, Color(0xFFFF9100), BulletStyle.BOMB)
                        spawnEnemyBullet(e.x - 24f * unit, e.y + e.radius * 0.5f, -150f * unit, speed * 0.94f, 12f * unit, Color(0xFFFF9100))
                        spawnEnemyBullet(e.x + 24f * unit, e.y + e.radius * 0.5f, 150f * unit, speed * 0.94f, 12f * unit, Color(0xFFFF9100))
                        e.shootTimer = 2.1f
                    }
                }
                EnemyType.BOSS -> {
                    val targetY = screenH * 0.21f
                    if (e.y < targetY) {
                        e.y += e.vy * dt
                    } else {
                        e.x += e.vx * dt
                        val minX = e.radius + 24f * unit
                        val maxX = screenW - e.radius - 24f * unit
                        if (e.x < minX) {
                            e.x = minX
                            e.vx = abs(e.vx)
                        } else if (e.x > maxX) {
                            e.x = maxX
                            e.vx = -abs(e.vx)
                        }

                        e.shootTimer -= dt
                        if (e.shootTimer <= 0f) {
                            fireBossPattern(e)
                            e.bossPattern = (e.bossPattern + 1) % 2
                            e.shootTimer = (1.35f - (wave / 3) * 0.08f).coerceAtLeast(0.75f)
                        }
                    }
                }
            }

            if (e.type != EnemyType.BOSS && e.y - e.radius > screenH + 80f * unit) {
                e.active = false
                continue
            }

            val dx = playerX - e.x
            val dy = playerY - e.y
            val hitR = playerHitR + e.radius * 0.78f
            if (dx * dx + dy * dy <= hitR * hitR) {
                damagePlayer()
                if (e.type != EnemyType.BOSS) {
                    e.hp -= 40f
                    if (e.hp <= 0f) onEnemyDestroyed(e)
                }
            }
        }
    }

    private fun fireBossPattern(boss: Enemy) {
        val speed = (460f + (wave / 3) * 28f) * unit
        if (boss.bossPattern == 0) {
            val count = 7
            for (i in 0 until count) {
                val angleDeg = 50f + (80f / (count - 1)) * i
                val rad = angleDeg * (PI.toFloat() / 180f)
                spawnEnemyBullet(
                    x = boss.x,
                    y = boss.y + boss.radius * 0.55f,
                    vx = cos(rad) * speed,
                    vy = sin(rad) * speed,
                    radius = 13f * unit,
                    color = Color(0xFFFF1744),
                    style = BulletStyle.NORMAL
                )
            }
        } else {
            val wingOffsets = floatArrayOf(-76f * unit, 76f * unit)
            for (offset in wingOffsets) {
                val sx = boss.x + offset
                val sy = boss.y + boss.radius * 0.4f
                val dx = playerX - sx
                val dy = playerY - sy
                val dist = hypot(dx, dy).coerceAtLeast(1f)
                spawnEnemyBullet(
                    x = sx,
                    y = sy,
                    vx = dx / dist * speed * 1.12f,
                    vy = dy / dist * speed * 1.12f,
                    radius = 16f * unit,
                    color = Color(0xFFFFD740),
                    style = BulletStyle.MISSILE
                )
            }
        }
    }

    private fun onEnemyDestroyed(e: Enemy) {
        e.active = false
        when (e.type) {
            EnemyType.SCOUT -> {
                score += 100
                audio.playExplode(big = false)
                spawnBurst(e.x, e.y, 14, Color(0xFFFFAB40), 340f * unit)
                spawnShockwave(e.x, e.y, 85f * unit, Color(0xFFFFAB40))
                if (Random.nextFloat() < 0.45f) spawnPowerUp(e.x, e.y, PowerUpType.COIN)
            }
            EnemyType.STRIKER -> {
                score += 220
                audio.playExplode(big = false)
                spawnBurst(e.x, e.y, 20, Color(0xFFFF5252), 400f * unit)
                spawnShockwave(e.x, e.y, 110f * unit, Color(0xFFFF5252))
                spawnPowerUp(e.x, e.y, PowerUpType.COIN)
                if (Random.nextFloat() < 0.14f) {
                    spawnPowerUp(e.x + 20f * unit, e.y, randomCombatPowerUp())
                }
            }
            EnemyType.BOMBER -> {
                score += 500
                audio.playExplode(big = true)
                triggerShake(0.22f, 14f * unit)
                spawnBurst(e.x, e.y, 30, Color(0xFFFF9100), 480f * unit)
                spawnShockwave(e.x, e.y, 165f * unit, Color(0xFFFF9100))
                spawnPowerUp(e.x - 24f * unit, e.y, PowerUpType.COIN)
                spawnPowerUp(e.x + 24f * unit, e.y, randomCombatPowerUp())
            }
            EnemyType.BOSS -> {
                bossHpFraction = 0f
                score += 2500 * (wave / 3).coerceAtLeast(1)
                hapticTrigger++
                audio.playExplode(big = true)
                triggerShake(0.55f, 28f * unit)
                spawnBurst(e.x, e.y, 65, Color(0xFFFFD740), 650f * unit)
                spawnBurst(e.x, e.y, 45, Color(0xFFFF5252), 520f * unit)
                spawnShockwave(e.x, e.y, 320f * unit, Color(0xFFFFD740))
                spawnShockwave(e.x, e.y, 220f * unit, Color(0xFFFF5252))
                repeat(6) {
                    spawnPowerUp(
                        e.x + (Random.nextFloat() - 0.5f) * 180f * unit,
                        e.y + (Random.nextFloat() - 0.5f) * 100f * unit,
                        PowerUpType.COIN
                    )
                }
                spawnPowerUp(e.x - 45f * unit, e.y, PowerUpType.WEAPON)
                spawnPowerUp(e.x + 45f * unit, e.y, PowerUpType.REPAIR)
                showBanner("BOSS DEFEATED!", 2.2f)
            }
        }
    }

    private fun randomCombatPowerUp(): PowerUpType {
        val r = Random.nextFloat()
        return when {
            r < 0.48f -> PowerUpType.WEAPON
            r < 0.78f -> PowerUpType.SHIELD
            else -> PowerUpType.REPAIR
        }
    }

    private fun updateEnemyBullets(dt: Float) {
        val playerHitR = 20f * unit
        for (b in enemyBullets) {
            if (!b.active) continue
            b.x += b.vx * dt
            b.y += b.vy * dt

            if (b.y > screenH + 60f * unit || b.y < -60f * unit ||
                b.x < -60f * unit || b.x > screenW + 60f * unit
            ) {
                b.active = false
                continue
            }

            val dx = b.x - playerX
            val dy = b.y - playerY
            val hitR = b.radius + playerHitR
            if (dx * dx + dy * dy <= hitR * hitR) {
                b.active = false
                damagePlayer()
            }
        }
    }

    private fun damagePlayer() {
        if (invulnTimer > 0f) return

        if (shieldTimer > 0f) {
            shieldTimer = (shieldTimer - 3.0f).coerceAtLeast(0f)
            if (shieldTimer <= 0f) shieldActive = false
            invulnTimer = 0.65f
            audio.playPlayerHit()
            triggerShake(0.14f, 10f * unit)
            spawnBurst(playerX, playerY, 18, Color(0xFF00E5FF), 360f * unit)
            spawnShockwave(playerX, playerY, 130f * unit, Color(0xFF00E5FF))
            return
        }

        playerHp--
        hapticTrigger++
        invulnTimer = 1.6f
        audio.playPlayerHit()
        triggerShake(0.28f, 20f * unit)
        if (weaponLevel > 1) weaponLevel--
        spawnBurst(playerX, playerY, 26, Color(0xFFFF5252), 440f * unit)
        spawnShockwave(playerX, playerY, 150f * unit, Color(0xFFFF5252))

        if (playerHp <= 0) {
            triggerGameOver()
        }
    }

    private fun triggerGameOver() {
        audio.playExplode(big = true)
        triggerShake(0.45f, 24f * unit)
        spawnBurst(playerX, playerY, 55, Color(0xFFFFAB40), 560f * unit)
        spawnShockwave(playerX, playerY, 240f * unit, Color(0xFFFFAB40))
        totalCoins += runCoins
        storage.totalCoins = totalCoins
        if (score > highScore) {
            highScore = score
            storage.highScore = highScore
        }
        phase = GamePhase.GAME_OVER
    }

    private fun spawnPowerUp(x: Float, y: Float, type: PowerUpType) {
        for (p in powerUps) {
            if (!p.active) {
                p.active = true
                p.type = type
                p.x = x.coerceIn(40f * unit, screenW - 40f * unit)
                p.y = y
                p.vy = if (type == PowerUpType.COIN) 230f * unit else 185f * unit
                p.radius = if (type == PowerUpType.COIN) 24f * unit else 34f * unit
                p.age = 0f
                return
            }
        }
    }

    private fun updatePowerUps(dt: Float) {
        val magnetDist = 230f * unit
        val pickupDist = 56f * unit

        for (p in powerUps) {
            if (!p.active) continue
            p.age += dt
            p.y += p.vy * dt

            val dx = playerX - p.x
            val dy = playerY - p.y
            val dist = hypot(dx, dy)

            if (dist < magnetDist && dist > 1f) {
                val pull = 780f * unit * dt
                p.x += dx / dist * pull
                p.y += dy / dist * pull
            }

            if (dist <= pickupDist + p.radius) {
                p.active = false
                when (p.type) {
                    PowerUpType.COIN -> {
                        runCoins += 10
                        score += 25
                        audio.playCoin()
                        spawnBurst(p.x, p.y, 6, Color(0xFFFFD740), 220f * unit)
                    }
                    PowerUpType.WEAPON -> {
                        audio.playPowerUp()
                        if (weaponLevel < 5) {
                            weaponLevel++
                            showBanner("WEAPON LV.$weaponLevel", 1.2f)
                        } else {
                            score += 300
                        }
                        spawnBurst(p.x, p.y, 12, Color(0xFF00E5FF), 300f * unit)
                    }
                    PowerUpType.SHIELD -> {
                        audio.playPowerUp()
                        shieldTimer = 8.0f
                        shieldActive = true
                        showBanner("ENERGY SHIELD!", 1.2f)
                        spawnBurst(p.x, p.y, 12, Color(0xFF40C4FF), 300f * unit)
                    }
                    PowerUpType.REPAIR -> {
                        audio.playPowerUp()
                        if (playerHp < playerMaxHp) {
                            playerHp++
                            showBanner("HULL REPAIRED +1", 1.2f)
                        } else {
                            score += 250
                        }
                        spawnBurst(p.x, p.y, 12, Color(0xFF69F0AE), 300f * unit)
                    }
                }
                continue
            }

            if (p.y - p.radius > screenH + 60f * unit) {
                p.active = false
            }
        }
    }

    private fun spawnBurst(x: Float, y: Float, count: Int, color: Color, maxSpeed: Float) {
        var spawned = 0
        for (pt in particles) {
            if (!pt.active) {
                val angle = Random.nextFloat() * 2f * PI.toFloat()
                val speed = (0.25f + Random.nextFloat() * 0.75f) * maxSpeed
                pt.active = true
                pt.x = x
                pt.y = y
                pt.vx = cos(angle) * speed
                pt.vy = sin(angle) * speed
                pt.maxLife = 0.25f + Random.nextFloat() * 0.35f
                pt.life = pt.maxLife
                pt.size = (5f + Random.nextFloat() * 10f) * unit
                pt.color = color
                spawned++
                if (spawned >= count) return
            }
        }
    }

    private fun spawnShockwave(x: Float, y: Float, maxRadius: Float, color: Color) {
        for (sw in shockwaves) {
            if (!sw.active) {
                sw.active = true
                sw.x = x
                sw.y = y
                sw.radius = 12f * unit
                sw.maxRadius = maxRadius
                sw.maxLife = 0.28f
                sw.life = sw.maxLife
                sw.color = color
                return
            }
        }
    }

    private fun updateParticles(dt: Float) {
        for (pt in particles) {
            if (!pt.active) continue
            pt.life -= dt
            if (pt.life <= 0f) {
                pt.active = false
                continue
            }
            pt.x += pt.vx * dt
            pt.y += pt.vy * dt
            pt.vx *= 0.95f
            pt.vy *= 0.95f
        }
    }

    private fun updateShockwaves(dt: Float) {
        for (sw in shockwaves) {
            if (!sw.active) continue
            sw.life -= dt
            if (sw.life <= 0f) {
                sw.active = false
                continue
            }
            val progress = 1f - (sw.life / sw.maxLife)
            sw.radius = 12f * unit + (sw.maxRadius - 12f * unit) * progress
        }
    }

    fun getOceanScrollPx(): Float = oceanScrollPx
    fun getElapsed(): Float = elapsedTime
}

