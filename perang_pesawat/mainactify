private class SpriteBank {
    @Volatile var player: ImageBitmap? = null
    @Volatile var enemyScout: ImageBitmap? = null
    @Volatile var enemyStriker: ImageBitmap? = null
    @Volatile var enemyBomber: ImageBitmap? = null
    @Volatile var boss: ImageBitmap? = null
    @Volatile var bgOcean: ImageBitmap? = null
    @Volatile var coin: ImageBitmap? = null
    @Volatile var powerWeapon: ImageBitmap? = null
    @Volatile var powerShield: ImageBitmap? = null
    @Volatile var powerRepair: ImageBitmap? = null
    @Volatile var bullet: ImageBitmap? = null
    @Volatile var missile: ImageBitmap? = null
    @Volatile var laser: ImageBitmap? = null
    @Volatile var bomb: ImageBitmap? = null

    fun loadFromAssets(context: Context) {
        val spriteFiles: List<String> = runCatching {
            context.assets.list("sprites")?.filterNotNull().orEmpty()
        }.getOrDefault(emptyList())

        player = decodeSprite(context, spriteFiles, listOf("Pesawat tempur utama pemain", "player"), maxDim = 768, trim = true)
        enemyScout = decodeSprite(context, spriteFiles, listOf("Pesawat musuh cepat (Scout)", "enemy_scout"), maxDim = 512, trim = true)
        enemyStriker = decodeSprite(context, spriteFiles, listOf("Pesawat musuh penembak (Striker)", "enemy_striker"), maxDim = 512, trim = true)
        enemyBomber = decodeSprite(context, spriteFiles, listOf("Pesawat bomber berat", "enemy_bomber"), maxDim = 640, trim = true)
        boss = decodeSprite(context, spriteFiles, listOf("Boss Sky Fortress", "boss"), maxDim = 1024, trim = true)
        bgOcean = decodeSprite(context, spriteFiles, listOf("Peta laut", "bg_ocean"), maxDim = 1920, trim = false)
        coin = decodeSprite(context, spriteFiles, listOf("Ikon koin", "coin"), maxDim = 256, trim = true)
        powerWeapon = decodeSprite(context, spriteFiles, listOf("power_weapon", "senjata laser"), maxDim = 256, trim = true)
        powerShield = decodeSprite(context, spriteFiles, listOf("Pelindung pesawat", "power_shield"), maxDim = 256, trim = true)
        powerRepair = decodeSprite(context, spriteFiles, listOf("Pemulihan HP", "power_repair"), maxDim = 256, trim = true)
        bullet = decodeSprite(context, spriteFiles, listOf("peluru", "bullet"), maxDim = 256, trim = true)
        missile = decodeSprite(context, spriteFiles, listOf("rudal", "missile"), maxDim = 256, trim = true)
        laser = decodeSprite(context, spriteFiles, listOf("senjata laser", "laser"), maxDim = 256, trim = true)
        bomb = decodeSprite(context, spriteFiles, listOf("bom", "bomb"), maxDim = 256, trim = true)
    }

    private fun decodeSprite(
        context: Context,
        filesInFolder: List<String>,
        candidateNames: List<String>,
        maxDim: Int,
        trim: Boolean
    ): ImageBitmap? {
        val supportedExts = setOf("png", "webp", "jpg", "jpeg")
        val matchedFile = candidateNames.firstNotNullOfOrNull { candidate ->
            filesInFolder.firstOrNull { fileName ->
                val dotIdx = fileName.lastIndexOf('.')
                if (dotIdx <= 0) return@firstOrNull false
                val base = fileName.substring(0, dotIdx)
                val ext = fileName.substring(dotIdx + 1).lowercase()
                ext in supportedExts && base.equals(candidate, ignoreCase = true)
            }
        } ?: return null

        val assetPath = "sprites/$matchedFile"
        return try {
            val boundsOpts = BitmapFactory.Options().apply { inJustDecodeBounds = true }
            context.assets.open(assetPath).use { input ->
                BitmapFactory.decodeStream(input, null, boundsOpts)
            }

            var sampleSize = 1
            if (boundsOpts.outWidth > 0 && boundsOpts.outHeight > 0) {
                while (boundsOpts.outWidth / sampleSize > maxDim ||
                    boundsOpts.outHeight / sampleSize > maxDim
                ) {
                    sampleSize *= 2
                }
            }

            val decodeOpts = BitmapFactory.Options().apply {
                inPreferredConfig = Bitmap.Config.ARGB_8888
                inScaled = false
                inSampleSize = sampleSize
            }
            val raw = context.assets.open(assetPath).use { input ->
                BitmapFactory.decodeStream(input, null, decodeOpts)
            } ?: return null

            val finalBmp = if (trim) trimTransparentBounds(raw) else raw
            if (finalBmp !== raw) raw.recycle()
            finalBmp.asImageBitmap()
        } catch (_: Exception) {
            null
        }
    }

    private fun trimTransparentBounds(src: Bitmap): Bitmap {
        if (!src.hasAlpha()) return src
        val w = src.width
        val h = src.height
        val pixels = IntArray(w * h)
        src.getPixels(pixels, 0, w, 0, 0, w, h)

        var minX = w
        var minY = h
        var maxX = -1
        var maxY = -1

        for (y in 0 until h) {
            val rowOffset = y * w
            for (x in 0 until w) {
                val alpha = (pixels[rowOffset + x] ushr 24) and 0xFF
                if (alpha > 16) {
                    if (x < minX) minX = x
                    if (x > maxX) maxX = x
                    if (y < minY) minY = y
                    if (y > maxY) maxY = y
                }
            }
        }
        if (maxX < minX || maxY < minY) return src
        if (minX == 0 && minY == 0 && maxX == w - 1 && maxY == h - 1) return src
        return Bitmap.createBitmap(src, minX, minY, maxX - minX + 1, maxY - minY + 1)
    }
}

// ============================================================================
// LOW-LATENCY SOUNDPOOL + MEDIAPLAYER BGM + SYNTH FALLBACK
// ============================================================================

private class GameAudioManager(private val context: Context) {
    private val synthSampleRate = 22050

    private val audioAttrs = AudioAttributes.Builder()
        .setUsage(AudioAttributes.USAGE_GAME)
        .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
        .build()

    private val soundPool = SoundPool.Builder()
        .setMaxStreams(10)
        .setAudioAttributes(audioAttrs)
        .build()

    private val loadedIds = ConcurrentHashMap.newKeySet<Int>()
    private var mediaPlayer: MediaPlayer? = null
    private var bgmPrepared = false

    @Volatile private var released = false
    @Volatile var sfxEnabled = true
    @Volatile var bgmEnabled = true

    @Volatile private var shootId = 0
    @Volatile private var explodeSmallId = 0
    @Volatile private var explodeBigId = 0
    @Volatile private var coinId = 0
    @Volatile private var powerUpId = 0
    @Volatile private var playerHitId = 0
    @Volatile private var bossWarnId = 0

    private var lastShootMs = 0L

    init {
        soundPool.setOnLoadCompleteListener { _, sampleId, status ->
            if (status == 0) loadedIds.add(sampleId)
        }
    }

    fun initialize(initialSfx: Boolean, initialBgm: Boolean) {
        sfxEnabled = initialSfx
        bgmEnabled = initialBgm
        if (released) return

        val cacheDir = File(context.cacheDir, "sky_strike_sfx_v2").apply { mkdirs() }

        shootId = loadSfxOrSynth("sfx_shoot", cacheDir) { buildShootWave() }
        explodeSmallId = loadSfxOrSynth("sfx_explode", cacheDir) { buildExplosionWave(0.24f, 1.0f) }
        explodeBigId = loadSfxOrSynth("sfx_boss_explode", cacheDir) { buildExplosionWave(0.55f, 0.55f) }
        coinId = loadSfxOrSynth("sfx_coin", cacheDir) { buildCoinWave() }
        powerUpId = loadSfxOrSynth("sfx_powerup", cacheDir) { buildPowerUpWave() }
        playerHitId = loadSfxOrSynth("sfx_hit", cacheDir) { buildHitWave() }
        bossWarnId = loadSfxOrSynth("sfx_boss_warning", cacheDir) { buildWarningWave() }

        initBgm(cacheDir)
    }

    private fun loadSfxOrSynth(baseName: String, cacheDir: File, synth: () -> ShortArray): Int {
        for (ext in arrayOf("ogg", "wav", "mp3")) {
            val assetPath = "audio/$baseName.$ext"
            try {
                context.assets.openFd(assetPath).use { afd ->
                    return soundPool.load(afd, 1)
                }
            } catch (_: Exception) {
                try {
                    val tempFile = File(cacheDir, "custom_$baseName.$ext")
                    context.assets.open(assetPath).use { input ->
                        FileOutputStream(tempFile).use { output -> input.copyTo(output) }
                    }
                    return soundPool.load(tempFile.absolutePath, 1)
                } catch (_: Exception) {
                    // Not present in assets
                }
            }
        }

        return try {
            val wavFile = File(cacheDir, "synth_$baseName.wav")
            if (!wavFile.exists()) {
                writeWavFile(wavFile, synth())
            }
            soundPool.load(wavFile.absolutePath, 1)
        } catch (_: Exception) {
            0
        }
    }

    private fun initBgm(cacheDir: File) {
        val bgmAttrs = AudioAttributes.Builder()
            .setUsage(AudioAttributes.USAGE_GAME)
            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
            .build()

        for (ext in arrayOf("ogg", "mp3", "wav")) {
            val assetPath = "audio/bgm_battle.$ext"
            val mp = MediaPlayer()
            try {
                mp.setAudioAttributes(bgmAttrs)
                mp.isLooping = true
                mp.setVolume(0.38f, 0.38f)

                try {
                    context.assets.openFd(assetPath).use { afd ->
                        mp.setDataSource(afd.fileDescriptor, afd.startOffset, afd.length)
                    }
                } catch (_: Exception) {
                    val bgmFile = File(cacheDir, "custom_bgm_battle.$ext")
                    context.assets.open(assetPath).use { input ->
                        FileOutputStream(bgmFile).use { output -> input.copyTo(output) }
                    }
                    mp.setDataSource(bgmFile.absolutePath)
                }

                mp.prepare()
                mediaPlayer = mp
                bgmPrepared = true
                if (bgmEnabled && !released) mp.start()
                return
            } catch (_: Exception) {
                runCatching { mp.release() }
            }
        }
    }

    fun playShoot() {
        val now = SystemClock.uptimeMillis()
        if (now - lastShootMs < 60L) return
        lastShootMs = now
        playSound(shootId, 0.28f, 0.96f + Random.nextFloat() * 0.1f)
    }

    fun playExplode(big: Boolean) {
        if (big) {
            playSound(explodeBigId, 0.78f, 0.95f)
        } else {
            playSound(explodeSmallId, 0.48f, 0.92f + Random.nextFloat() * 0.18f)
        }
    }

    fun playCoin() = playSound(coinId, 0.42f, 1.0f + Random.nextFloat() * 0.08f)
    fun playPowerUp() = playSound(powerUpId, 0.62f, 1.0f)
    fun playPlayerHit() = playSound(playerHitId, 0.75f, 1.0f)
    fun playBossWarning() = playSound(bossWarnId, 0.68f, 1.0f)

    private fun playSound(soundId: Int, volume: Float, rate: Float) {
        if (released || !sfxEnabled || soundId == 0 || !loadedIds.contains(soundId)) return
        soundPool.play(soundId, volume, volume, 1, 0, rate)
    }

    fun updateSfxEnabled(enabled: Boolean) {
        sfxEnabled = enabled
    }

    fun updateBgmEnabled(enabled: Boolean) {
        bgmEnabled = enabled
        val mp = mediaPlayer ?: return
        if (!bgmPrepared || released) return
        runCatching {
            if (enabled && !mp.isPlaying) mp.start()
            else if (!enabled && mp.isPlaying) mp.pause()
        }
    }

    fun onAppPause() {
        if (released) return
        runCatching { soundPool.autoPause() }
        val mp = mediaPlayer
        if (mp != null && bgmPrepared) {
            runCatching { if (mp.isPlaying) mp.pause() }
        }
    }

    fun onAppResume() {
        if (released) return
        runCatching { soundPool.autoResume() }
        val mp = mediaPlayer
        if (mp != null && bgmPrepared && bgmEnabled) {
            runCatching { if (!mp.isPlaying) mp.start() }
        }
    }

    fun release() {
        if (released) return
        released = true
        runCatching { soundPool.release() }
        runCatching {
            mediaPlayer?.stop()
            mediaPlayer?.release()
        }
        mediaPlayer = null
        bgmPrepared = false
    }

    private fun buildShootWave(): ShortArray {
        val count = (synthSampleRate * 0.075f).toInt()
        val out = ShortArray(count)
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val freq = 1050.0 - 720.0 * t
            phase += 2.0 * PI * freq / synthSampleRate
            val env = exp((-5.5f * t).toDouble()).toFloat()
            val sq = if (sin(phase) >= 0.0) 0.55f else -0.55f
            out[i] = (sq * env * 22000f).toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun buildExplosionWave(durationSec: Float, pitchScale: Float): ShortArray {
        val count = (synthSampleRate * durationSec).toInt()
        val out = ShortArray(count)
        var lp = 0f
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val white = Random.nextFloat() * 2f - 1f
            val cutoff = (0.28f * (1f - t * 0.7f)).coerceIn(0.05f, 0.35f)
            lp += cutoff * (white - lp)
            phase += 2.0 * PI * (120.0 * pitchScale * (1.0 - t * 0.65)) / synthSampleRate
            val rumble = sin(phase).toFloat() * 0.45f
            val env = (1f - t) * (1f - t)
            out[i] = ((lp * 1.4f + rumble) * env * 28000f).toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun buildCoinWave(): ShortArray {
        val count = (synthSampleRate * 0.14f).toInt()
        val out = ShortArray(count)
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val freq = if (t < 0.38f) 1175.0 else 1760.0
            phase += 2.0 * PI * freq / synthSampleRate
            val env = (1f - t * 0.85f)
            out[i] = (sin(phase).toFloat() * env * 21000f).toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun buildPowerUpWave(): ShortArray {
        val count = (synthSampleRate * 0.28f).toInt()
        val out = ShortArray(count)
        val notes = doubleArrayOf(523.25, 659.25, 783.99, 1046.50)
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val noteIdx = (t * notes.size).toInt().coerceIn(0, notes.lastIndex)
            phase += 2.0 * PI * notes[noteIdx] / synthSampleRate
            val env = (1f - t * 0.6f)
            out[i] = (sin(phase).toFloat() * env * 22000f).toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun buildHitWave(): ShortArray {
        val count = (synthSampleRate * 0.22f).toInt()
        val out = ShortArray(count)
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val freq = 260.0 - 180.0 * t
            phase += 2.0 * PI * freq / synthSampleRate
            val noise = (Random.nextFloat() * 2f - 1f) * 0.35f
            val env = 1f - t
            out[i] = ((sin(phase).toFloat() * 0.7f + noise) * env * 27000f)
                .toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun buildWarningWave(): ShortArray {
        val count = (synthSampleRate * 0.65f).toInt()
        val out = ShortArray(count)
        var phase = 0.0
        for (i in 0 until count) {
            val t = i.toFloat() / count
            val cycle = (t * 2.0f) % 1.0f
            val freq = 420.0 + 380.0 * sin(cycle * PI)
            phase += 2.0 * PI * freq / synthSampleRate
            val env = if (t > 0.85f) (1f - t) / 0.15f else 1f
            out[i] = (sin(phase).toFloat() * env * 21000f).toInt().coerceIn(-32767, 32767).toShort()
        }
        return out
    }

    private fun writeWavFile(file: File, samples: ShortArray) {
        val dataSize = samples.size * 2
        val header = ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN)
        header.put("RIFF".toByteArray(Charsets.US_ASCII))
        header.putInt(36 + dataSize)
        header.put("WAVE".toByteArray(Charsets.US_ASCII))
        header.put("fmt ".toByteArray(Charsets.US_ASCII))
        header.putInt(16)
        header.putShort(1)
        header.putShort(1)
        header.putInt(synthSampleRate)
        header.putInt(synthSampleRate * 2)
        header.putShort(2)
        header.putShort(16)
        header.put("data".toByteArray(Charsets.US_ASCII))
        header.putInt(dataSize)

        val pcmBuffer = ByteBuffer.allocate(dataSize).order(ByteOrder.LITTLE_ENDIAN)
        for (s in samples) pcmBuffer.putShort(s)

        FileOutputStream(file).use { out ->
            out.write(header.array())
            out.write(pcmBuffer.array())
        }
    }
}

