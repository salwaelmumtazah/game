@Composable
private fun SkyStrikeApp() {
    val context = LocalContext.current
    val appContext = context.applicationContext
    val haptic = LocalHapticFeedback.current
    val lifecycleOwner = LocalLifecycleOwner.current

    val storage = remember { GameStorage(appContext) }
    val sprites = remember { SpriteBank() }
    val audio = remember { GameAudioManager(appContext) }
    val engine = remember { SkyStrikeEngine(storage, sprites, audio) }

    LaunchedEffect(Unit) {
        withContext(Dispatchers.IO) {
            sprites.loadFromAssets(appContext)
            audio.initialize(storage.sfxEnabled, storage.bgmEnabled)
        }
    }

    DisposableEffect(lifecycleOwner) {
        val observer = LifecycleEventObserver { _, event ->
            when (event) {
                Lifecycle.Event.ON_PAUSE -> {
                    engine.pauseGame()
                    audio.onAppPause()
                }
                Lifecycle.Event.ON_RESUME -> {
                    audio.onAppResume()
                }
                else -> Unit
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose {
            lifecycleOwner.lifecycle.removeObserver(observer)
            audio.release()
        }
    }

    LaunchedEffect(engine.hapticTrigger) {
        if (engine.hapticTrigger > 0) {
            haptic.performHapticFeedback(HapticFeedbackType.LongPress)
        }
    }

    LaunchedEffect(Unit) {
        var lastTimeNanos = 0L
        while (isActive) {
            withFrameNanos { frameTimeNanos ->
                if (lastTimeNanos != 0L) {
                    val dt = ((frameTimeNanos - lastTimeNanos) / 1_000_000_000f).coerceIn(0f, 0.05f)
                    engine.update(dt)
                }
                lastTimeNanos = frameTimeNanos
            }
        }
    }

    Box(modifier = Modifier.fillMaxSize().background(Color(0xFF061A2E))) {
        Canvas(
            modifier = Modifier
                .fillMaxSize()
                .onSizeChanged { size ->
                    engine.setViewport(size.width.toFloat(), size.height.toFloat())
                }
                .pointerInput(Unit) {
                    detectDragGestures { change, dragAmount ->
                        change.consume()
                        engine.movePlayer(dragAmount.x, dragAmount.y)
                    }
                }
        ) {
            val tick = engine.frameTick
            if (tick >= 0L && engine.screenW > 0f) {
                drawGameWorld(engine)
            }
        }

        when (engine.phase) {
            GamePhase.MENU -> MainMenuOverlay(engine)
            GamePhase.PLAYING -> GameHudOverlay(engine)
            GamePhase.PAUSED -> {
                GameHudOverlay(engine)
                PauseOverlay(engine)
            }
            GamePhase.GAME_OVER -> GameOverOverlay(engine)
        }
    }
}

