// ============================================================================
// HD RENDERER (PNG/JPG SPRITES + 3D DROP SHADOW + MIRROR SCROLLING + JUICE)
// ============================================================================

private val hitFlashFilter = ColorFilter.tint(Color.White, BlendMode.SrcAtop)
private val dropShadowFilter = ColorFilter.tint(Color(0x55000000), BlendMode.SrcIn)

private fun DrawScope.drawSpriteCentered(
    sprite: ImageBitmap,
    cx: Float,
    cy: Float,
    widthPx: Float,
    heightPx: Float,
    colorFilter: ColorFilter? = null
) {
    val sw = sprite.width.toFloat().coerceAtLeast(1f)
    val sh = sprite.height.toFloat().coerceAtLeast(1f)
    val scaleFactor = minOf(widthPx / sw, heightPx / sh)
    val w = (sw * scaleFactor).roundToInt().coerceAtLeast(1)
    val h = (sh * scaleFactor).roundToInt().coerceAtLeast(1)
    drawImage(
        image = sprite,
        dstOffset = IntOffset((cx - w * 0.5f).roundToInt(), (cy - h * 0.5f).roundToInt()),
        dstSize = IntSize(w, h),
        colorFilter = colorFilter,
        filterQuality = FilterQuality.High
    )
}

private fun DrawScope.drawGameWorld(engine: SkyStrikeEngine) {
    val u = engine.unit

    translate(left = engine.shakeOffsetX, top = engine.shakeOffsetY) {
        // 1. Background (Seamless Mirror-Scrolling Map OR Procedural Ocean)
        val bgSprite = engine.sprites.bgOcean
        if (bgSprite != null && bgSprite.width > 0 && bgSprite.height > 0) {
            val tileW = size.width.roundToInt().coerceAtLeast(1)
            val tileH = (size.width * (bgSprite.height.toFloat() / bgSprite.width.toFloat()))
                .roundToInt().coerceAtLeast(1)
            val cycleH = tileH * 2
            val scroll = (engine.getOceanScrollPx() % cycleH).roundToInt()

            var k = -2
            while (true) {
                val tileTop = scroll + k * tileH
                if (tileTop >= size.height) break
                if (tileTop + tileH > 0) {
                    val flipped = (k and 1) != 0
                    if (flipped) {
                        scale(
                            scaleX = 1f,
                            scaleY = -1f,
                            pivot = Offset(size.width * 0.5f, tileTop + tileH * 0.5f)
                        ) {
                            drawImage(
                                image = bgSprite,
                                dstOffset = IntOffset(0, tileTop),
                                dstSize = IntSize(tileW, tileH + 1),
                                filterQuality = FilterQuality.High
                            )
                        }
                    } else {
                        drawImage(
                            image = bgSprite,
                            dstOffset = IntOffset(0, tileTop),
                            dstSize = IntSize(tileW, tileH + 1),
                            filterQuality = FilterQuality.High
                        )
                    }
                }
                k++
            }
        } else {
            drawRect(
                brush = Brush.verticalGradient(
                    colors = listOf(Color(0xFF08223C), Color(0xFF0C3559), Color(0xFF072038))
                )
            )
            val waveSpacing = 120f * u
            var wy = (engine.getOceanScrollPx() % waveSpacing) - waveSpacing
            while (wy < size.height + waveSpacing) {
                drawLine(
                    color = Color(0x1480D8FF),
                    start = Offset(0f, wy),
                    end = Offset(size.width, wy),
                    strokeWidth = 2f * u
                )
                wy += waveSpacing
            }
            for (island in engine.islands) {
                rotate(degrees = island.rotation, pivot = Offset(island.x, island.y)) {
                    drawOval(
                        color = Color(0x331DE9B6),
                        topLeft = Offset(island.x - island.radiusX * 1.18f, island.y - island.radiusY * 1.18f),
                        size = Size(island.radiusX * 2.36f, island.radiusY * 2.36f)
                    )
                    drawOval(
                        color = Color(0x55C8B575),
                        topLeft = Offset(island.x - island.radiusX, island.y - island.radiusY),
                        size = Size(island.radiusX * 2f, island.radiusY * 2f)
                    )
                    drawOval(
                        color = Color(0x661E5631),
                        topLeft = Offset(island.x - island.radiusX * 0.72f, island.y - island.radiusY * 0.72f),
                        size = Size(island.radiusX * 1.44f, island.radiusY * 1.44f)
                    )
                }
            }
        }

        // 2. Power-Ups & Coins
        for (p in engine.powerUps) {
            if (!p.active) continue
            drawPowerUp(p, u, engine.sprites)
        }

        // 3. Player Bullets (bullet_main.png, missile.png, lasser.png)
        for (b in engine.playerBullets) {
            if (!b.active) continue
            drawPlayerBullet(b, u, engine.sprites)
        }

        // 4. Enemies & Boss
        for (e in engine.enemies) {
            if (!e.active) continue
            drawEnemyPlane(e, u, engine.reusablePath, engine.sprites)
        }

        // 5. Enemy Bullets (bomb.png, missile.png, plasma)
        for (b in engine.enemyBullets) {
            if (!b.active) continue
            drawEnemyBullet(b, u, engine.sprites)
        }

        // 6. Player Fighter Jet
        if (engine.phase != GamePhase.GAME_OVER) {
            val blinkVisible = engine.invulnTimer <= 0f || ((engine.invulnTimer * 18f).toInt() % 2 == 0)
            if (blinkVisible) {
                drawPlayerPlane(engine, u)
            }
        }

        // 7. Shockwave Rings & Explosion Particles
        for (sw in engine.shockwaves) {
            if (!sw.active) continue
            val alpha = (sw.life / sw.maxLife).coerceIn(0f, 1f)
            drawCircle(
                color = sw.color.copy(alpha = alpha * 0.7f),
                radius = sw.radius,
                center = Offset(sw.x, sw.y),
                style = Stroke(width = (8f * u * alpha).coerceAtLeast(1f))
            )
        }
        for (pt in engine.particles) {
            if (!pt.active) continue
            val alpha = (pt.life / pt.maxLife).coerceIn(0f, 1f)
            drawCircle(
                color = pt.color.copy(alpha = alpha),
                radius = pt.size * alpha,
                center = Offset(pt.x, pt.y)
            )
        }

        // 8. Foreground Drifting Clouds
        for (cloud in engine.clouds) {
            drawCircle(
                color = Color.White.copy(alpha = cloud.alpha),
                radius = cloud.radius,
                center = Offset(cloud.x, cloud.y)
            )
            drawCircle(
                color = Color.White.copy(alpha = cloud.alpha * 0.8f),
                radius = cloud.radius * 0.72f,
                center = Offset(cloud.x + cloud.radius * 0.5f, cloud.y + cloud.radius * 0.25f)
            )
        }
    }
}

private fun DrawScope.drawPlayerBullet(b: Bullet, u: Float, sprites: SpriteBank) {
    val sprite = when (b.style) {
        BulletStyle.LASER -> sprites.laser ?: sprites.bullet
        BulletStyle.MISSILE -> sprites.missile ?: sprites.bullet
        BulletStyle.NORMAL, BulletStyle.BOMB -> sprites.bullet
    }

    if (sprite != null) {
        val angleDeg = (atan2(b.vy, b.vx) * (180f / PI.toFloat())) + 90f
        val drawSize = when (b.style) {
            BulletStyle.LASER -> 74f * u
            BulletStyle.MISSILE -> 64f * u
            BulletStyle.NORMAL, BulletStyle.BOMB -> 46f * u
        }
        rotate(degrees = angleDeg, pivot = Offset(b.x, b.y)) {
            drawSpriteCentered(sprite, b.x, b.y, drawSize, drawSize)
        }
    } else {
        drawRoundRect(
            color = b.color.copy(alpha = 0.35f),
            topLeft = Offset(b.x - b.radius * 0.9f, b.y - b.radius * 2.4f),
            size = Size(b.radius * 1.8f, b.radius * 4.8f),
            cornerRadius = CornerRadius(b.radius, b.radius)
        )
        drawRoundRect(
            color = Color.White,
            topLeft = Offset(b.x - b.radius * 0.42f, b.y - b.radius * 1.9f),
            size = Size(b.radius * 0.84f, b.radius * 3.8f),
            cornerRadius = CornerRadius(b.radius, b.radius)
        )
    }
}

private fun DrawScope.drawEnemyBullet(b: Bullet, u: Float, sprites: SpriteBank) {
    when (b.style) {
        BulletStyle.BOMB -> {
            val bombSprite = sprites.bomb
            if (bombSprite != null) {
                val s = 54f * u
                drawCircle(Color(0x44FF9100), radius = b.radius * 1.4f, center = Offset(b.x, b.y))
                drawSpriteCentered(bombSprite, b.x, b.y, s, s)
                return
            }
        }
        BulletStyle.MISSILE -> {
            val missileSprite = sprites.missile
            if (missileSprite != null) {
                val angleDeg = (atan2(b.vy, b.vx) * (180f / PI.toFloat())) + 90f
                val s = 60f * u
                rotate(degrees = angleDeg, pivot = Offset(b.x, b.y)) {
                    drawSpriteCentered(missileSprite, b.x, b.y, s, s)
                }
                return
            }
        }
        BulletStyle.NORMAL, BulletStyle.LASER -> Unit
    }

    drawCircle(color = b.color.copy(alpha = 0.35f), radius = b.radius * 1.55f, center = Offset(b.x, b.y))
    drawCircle(color = b.color, radius = b.radius, center = Offset(b.x, b.y))
    drawCircle(color = Color.White, radius = b.radius * 0.45f, center = Offset(b.x, b.y))
}

private fun DrawScope.drawPlayerPlane(engine: SkyStrikeEngine, u: Float) {
    val x = engine.playerX
    val y = engine.playerY
    val path = engine.reusablePath
    val pulse = 0.85f + 0.15f * sin(engine.getElapsed() * 32f)
    val playerSprite = engine.sprites.player

    // 3D Dynamic Drop Shadow under Player Plane
    if (playerSprite != null) {
        rotate(degrees = engine.playerBank * 14f, pivot = Offset(x + 20f * u, y + 26f * u)) {
            drawSpriteCentered(
                sprite = playerSprite,
                cx = x + 20f * u,
                cy = y + 26f * u,
                widthPx = 152f * u,
                heightPx = 152f * u,
                colorFilter = dropShadowFilter
            )
        }
    }

    rotate(degrees = engine.playerBank * 14f, pivot = Offset(x, y)) {
        if (engine.muzzleFlashTimer > 0f) {
            drawCircle(
                color = Color(0x8800E5FF),
                radius = 24f * u,
                center = Offset(x, y - 54f * u)
            )
            drawCircle(
                color = Color.White,
                radius = 10f * u,
                center = Offset(x, y - 54f * u)
            )
        }

        drawOval(
            color = Color(0xFF00E5FF).copy(alpha = 0.75f),
            topLeft = Offset(x - 22f * u, y + 40f * u),
            size = Size(14f * u, 30f * u * pulse)
        )
        drawOval(
            color = Color(0xFF00E5FF).copy(alpha = 0.75f),
            topLeft = Offset(x + 8f * u, y + 40f * u),
            size = Size(14f * u, 30f * u * pulse)
        )

        if (playerSprite != null) {
            drawSpriteCentered(
                sprite = playerSprite,
                cx = x,
                cy = y,
                widthPx = 165f * u,
                heightPx = 165f * u
            )
        } else {
            path.reset()
            path.moveTo(x, y - 34f * u)
            path.lineTo(x + 62f * u, y + 18f * u)
            path.lineTo(x + 56f * u, y + 30f * u)
            path.lineTo(x + 14f * u, y + 20f * u)
            path.lineTo(x - 14f * u, y + 20f * u)
            path.lineTo(x - 56f * u, y + 30f * u)
            path.lineTo(x - 62f * u, y + 18f * u)
            path.close()
            drawPath(path = path, color = Color(0xFFCFD8DC))

            drawLine(
                color = Color(0xFF00B0FF),
                start = Offset(x - 46f * u, y + 16f * u),
                end = Offset(x - 20f * u, y + 4f * u),
                strokeWidth = 6f * u,
                cap = StrokeCap.Round
            )
            drawLine(
                color = Color(0xFF00B0FF),
                start = Offset(x + 46f * u, y + 16f * u),
                end = Offset(x + 20f * u, y + 4f * u),
                strokeWidth = 6f * u,
                cap = StrokeCap.Round
            )

            path.reset()
            path.moveTo(x, y + 18f * u)
            path.lineTo(x + 30f * u, y + 44f * u)
            path.lineTo(x + 24f * u, y + 48f * u)
            path.lineTo(x - 24f * u, y + 48f * u)
            path.lineTo(x - 30f * u, y + 44f * u)
            path.close()
            drawPath(path = path, color = Color(0xFF90A4AE))

            path.reset()
            path.moveTo(x, y - 54f * u)
            path.lineTo(x + 14f * u, y - 10f * u)
            path.lineTo(x + 12f * u, y + 42f * u)
            path.lineTo(x - 12f * u, y + 42f * u)
            path.lineTo(x - 14f * u, y - 10f * u)
            path.close()
            drawPath(path = path, color = Color(0xFFECEFF1))

            drawOval(
                color = Color(0xFF00E5FF),
                topLeft = Offset(x - 7f * u, y - 26f * u),
                size = Size(14f * u, 28f * u)
            )
        }
    }

    if (engine.shieldTimer > 0f) {
        drawCircle(color = Color(0x3300E5FF), radius = 84f * u, center = Offset(x, y))
        drawCircle(
            color = Color(0xCC00E5FF),
            radius = 84f * u,
            center = Offset(x, y),
            style = Stroke(width = 4f * u)
        )
    }
}

private fun DrawScope.drawEnemyPlane(e: Enemy, u: Float, path: Path, sprites: SpriteBank) {
    val x = e.x
    val y = e.y
    val r = e.radius
    val isFlashing = e.hitFlash > 0f

    val customSprite = when (e.type) {
        EnemyType.SCOUT -> sprites.enemyScout
        EnemyType.STRIKER -> sprites.enemyStriker
        EnemyType.BOMBER -> sprites.enemyBomber
        EnemyType.BOSS -> sprites.boss
    }

    if (customSprite != null) {
        val drawSize = if (e.type == EnemyType.BOSS) r * 2.65f else r * 2.45f
        val shadowShiftX = if (e.type == EnemyType.BOSS) 28f * u else 16f * u
        val shadowShiftY = if (e.type == EnemyType.BOSS) 36f * u else 22f * u

        // Jika Boss ternyata sudah benar menghadap bawah, ubah baris ini jadi:
        // val angle = if (e.type == EnemyType.BOSS) 0f else 180f
        val angle = 180f

        rotate(degrees = angle, pivot = Offset(x + shadowShiftX, y + shadowShiftY)) {
            drawSpriteCentered(
                sprite = customSprite,
                cx = x + shadowShiftX,
                cy = y + shadowShiftY,
                widthPx = drawSize * 0.94f,
                heightPx = drawSize * 0.94f,
                colorFilter = dropShadowFilter
            )
        }
        rotate(degrees = angle, pivot = Offset(x, y)) {
            drawSpriteCentered(
                sprite = customSprite,
                cx = x,
                cy = y,
                widthPx = drawSize,
                heightPx = drawSize,
                colorFilter = if (isFlashing) hitFlashFilter else null
            )
        }
    } else {
        when (e.type) {
            EnemyType.SCOUT -> {
                val bodyColor = if (isFlashing) Color.White else Color(0xFF9CCC65)
                val wingColor = if (isFlashing) Color.White else Color(0xFF558B2F)

                path.reset()
                path.moveTo(x, y + r)
                path.lineTo(x + r * 0.95f, y - r * 0.25f)
                path.lineTo(x, y - r * 0.65f)
                path.lineTo(x - r * 0.95f, y - r * 0.25f)
                path.close()
                drawPath(path, wingColor)

                drawOval(bodyColor, Offset(x - r * 0.26f, y - r * 0.75f), Size(r * 0.52f, r * 1.55f))
                drawCircle(Color(0xFFFFD740), r * 0.16f, Offset(x, y + r * 0.1f))
            }

            EnemyType.STRIKER -> {
                val bodyColor = if (isFlashing) Color.White else Color(0xFFEF5350)
                val wingColor = if (isFlashing) Color.White else Color(0xFFB71C1C)

                path.reset()
                path.moveTo(x, y + r * 0.95f)
                path.lineTo(x + r * 1.05f, y - r * 0.1f)
                path.lineTo(x + r * 0.75f, y - r * 0.75f)
                path.lineTo(x - r * 0.75f, y - r * 0.75f)
                path.lineTo(x - r * 1.05f, y - r * 0.1f)
                path.close()
                drawPath(path, wingColor)

                drawOval(bodyColor, Offset(x - r * 0.3f, y - r * 0.85f), Size(r * 0.6f, r * 1.75f))
                drawCircle(Color(0xFFFFAB40), r * 0.18f, Offset(x, y + r * 0.15f))
            }

            EnemyType.BOMBER -> {
                val hullColor = if (isFlashing) Color.White else Color(0xFF546E7A)
                val accentColor = if (isFlashing) Color.White else Color(0xFFFF6D00)

                drawRoundRect(
                    color = hullColor,
                    topLeft = Offset(x - r * 1.15f, y - r * 0.3f),
                    size = Size(r * 2.3f, r * 0.58f),
                    cornerRadius = CornerRadius(12f * u, 12f * u)
                )
                drawOval(accentColor, Offset(x - r * 0.65f, y - r * 0.6f), Size(r * 0.32f, r * 1.15f))
                drawOval(accentColor, Offset(x + r * 0.33f, y - r * 0.6f), Size(r * 0.32f, r * 1.15f))
                drawOval(Color(0xFF37474F), Offset(x - r * 0.34f, y - r * 0.85f), Size(r * 0.68f, r * 1.75f))
                drawCircle(Color(0xFFFFD740), r * 0.18f, Offset(x, y + r * 0.25f))
            }

            EnemyType.BOSS -> {
                val armor = if (isFlashing) Color.White else Color(0xFF37474F)
                val trim = if (isFlashing) Color.White else Color(0xFFD50000)

                path.reset()
                path.moveTo(x - r * 1.25f, y - r * 0.15f)
                path.lineTo(x + r * 1.25f, y - r * 0.15f)
                path.lineTo(x + r * 0.95f, y + r * 0.45f)
                path.lineTo(x - r * 0.95f, y + r * 0.45f)
                path.close()
                drawPath(path, armor)

                drawRect(trim, Offset(x - r * 0.72f, y + r * 0.2f), Size(r * 0.24f, r * 0.55f))
                drawRect(trim, Offset(x + r * 0.48f, y + r * 0.2f), Size(r * 0.24f, r * 0.55f))

                drawOval(Color(0xFF263238), Offset(x - r * 0.48f, y - r * 0.75f), Size(r * 0.96f, r * 1.55f))
                drawCircle(Color(0xFFFF1744), r * 0.24f, Offset(x, y + r * 0.1f))
                drawCircle(Color(0xFFFFD740), r * 0.12f, Offset(x, y + r * 0.1f))
            }
        }
    }

    if (e.type != EnemyType.BOSS && e.hp < e.maxHp) {
        val barW = r * 1.4f
        val barH = 6f * u
        val top = y - r - 14f * u
        drawRect(Color(0x88000000), Offset(x - barW * 0.5f, top), Size(barW, barH))
        drawRect(
            Color(0xFFFF5252),
            Offset(x - barW * 0.5f, top),
            Size(barW * (e.hp / e.maxHp).coerceIn(0f, 1f), barH)
        )
    }
}

private fun DrawScope.drawPowerUp(p: PowerUp, u: Float, sprites: SpriteBank) {
    val pulse = 1f + 0.1f * sin(p.age * 8f)
    val r = p.radius * pulse
    val customSprite = when (p.type) {
        PowerUpType.COIN -> sprites.coin
        PowerUpType.WEAPON -> sprites.powerWeapon
        PowerUpType.SHIELD -> sprites.powerShield
        PowerUpType.REPAIR -> sprites.powerRepair
    }

    if (customSprite != null) {
        val glowColor = when (p.type) {
            PowerUpType.COIN -> Color(0x44FFD740)
            PowerUpType.WEAPON -> Color(0x4400E5FF)
            PowerUpType.SHIELD -> Color(0x4440C4FF)
            PowerUpType.REPAIR -> Color(0x4469F0AE)
        }
        drawCircle(glowColor, radius = r * 1.25f, center = Offset(p.x, p.y))
        drawSpriteCentered(customSprite, p.x, p.y, r * 2.2f, r * 2.2f)
        return
    }

    val color = when (p.type) {
        PowerUpType.COIN -> Color(0xFFFFD740)
        PowerUpType.WEAPON -> Color(0xFF00E5FF)
        PowerUpType.SHIELD -> Color(0xFF40C4FF)
        PowerUpType.REPAIR -> Color(0xFF69F0AE)
    }

    drawCircle(color.copy(alpha = 0.28f), radius = r * 1.4f, center = Offset(p.x, p.y))
    drawCircle(color, radius = r, center = Offset(p.x, p.y))
    drawCircle(Color(0xFF071A2F), radius = r * 0.65f, center = Offset(p.x, p.y))

    when (p.type) {
        PowerUpType.COIN -> {
            drawCircle(Color(0xFFFFD740), radius = r * 0.36f, center = Offset(p.x, p.y))
        }
        PowerUpType.REPAIR -> {
            drawLine(color, Offset(p.x - r * 0.35f, p.y), Offset(p.x + r * 0.35f, p.y), 5f * u, StrokeCap.Round)
            drawLine(color, Offset(p.x, p.y - r * 0.35f), Offset(p.x, p.y + r * 0.35f), 5f * u, StrokeCap.Round)
        }
        PowerUpType.WEAPON -> {
            drawLine(color, Offset(p.x, p.y - r * 0.38f), Offset(p.x, p.y + r * 0.38f), 5f * u, StrokeCap.Round)
            drawLine(color, Offset(p.x - r * 0.28f, p.y - r * 0.1f), Offset(p.x, p.y - r * 0.38f), 5f * u, StrokeCap.Round)
            drawLine(color, Offset(p.x + r * 0.28f, p.y - r * 0.1f), Offset(p.x, p.y - r * 0.38f), 5f * u, StrokeCap.Round)
        }
        PowerUpType.SHIELD -> {
            drawCircle(color, radius = r * 0.34f, center = Offset(p.x, p.y), style = Stroke(4f * u))
        }
    }
}
